SERVER_ADDRESS=:8080

# MySQL — charset and parseTime are required for GORM
DATABASE_DSN=root:1234@tcp(127.0.0.1:3306)/inventory_billing?charset=utf8mb4&parseTime=True&loc=Local
DATABASE_DEBUG=false
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MIN=30

JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRY_HOUR=1
JWT_REFRESH_EXPIRY_DAY=7

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# GST — seller details used in invoice generation and intra/inter-state tax detection
GST_SELLER_NAME="My Business Pvt Ltd"
GST_SELLER_GSTIN=29ABCDE1234F1Z5
GST_SELLER_ADDRESS="123 Main Street, Bengaluru, Karnataka 560001"
GST_STATE_CODE=29

# Worker — Asynq background job processor
WORKER_CONCURRENCY=10

# Mail — transactional email (set MAIL_PROVIDER=smtp for production)
# MAIL_PROVIDER=noop             # "noop" discards all email (default for dev)
# MAIL_PROVIDER=smtp             # use SMTP for production
MAIL_PROVIDER=noop
MAIL_FROM="Acme Billing <noreply@acme.com>"
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=noreply@acme.com
MAIL_SMTP_PASS=your-smtp-password
MAIL_USE_TLS=false

# Storage — PDF and asset storage backend
# STORAGE_PROVIDER=local         # save to local filesystem (default)
# STORAGE_PROVIDER=s3            # use AWS S3 / MinIO (implement pkg/storage/s3.go)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR="./data/assets  # directory on disk"
STORAGE_LOCAL_URL="http://localhost:8080/assets  # public URL prefix"
